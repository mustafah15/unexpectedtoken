---
import { withBase } from '../utils/urls';
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---
<a class="skip-link" href="#main">Skip to content</a>
<header class="site-header">
 <div class="identity"><a href={withBase('/')}>{SITE_TITLE}</a><span> / thoughts and writings</span></div>
 <nav aria-label="Main navigation">
  <HeaderLink href={withBase('/')}>home</HeaderLink>
  <HeaderLink href={withBase('/blog')}>blog</HeaderLink>
  <HeaderLink href={withBase('/about')}>about</HeaderLink>
  <a href={withBase('/rss.xml')}>rss</a>
 </nav>
</header>
<style>
 .site-header { max-width: 880px; margin: auto; padding: 48px 24px 56px; display: flex; align-items: baseline; justify-content: space-between; gap: 24px; }
 .identity { font-size: 20px; }
 .identity > a { font-weight: 650; letter-spacing: -0.03em; }
 .identity span { color: var(--muted); font-size: 16px; }
 nav { display: flex; gap: 16px; font-size: 16px; }
 @media (max-width: 700px) {
  .site-header { flex-direction: column; gap: 16px; padding-top: 30px; padding-bottom: 40px; }
  .identity span { display: block; font-size: 16px; margin-top: 4px; }
 }
</style>
