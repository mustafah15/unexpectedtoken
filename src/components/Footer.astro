---
import { withBase } from '../utils/urls';
import { SITE_TITLE } from '../consts';
---
<footer class="site-footer">
 <p>&copy; {new Date().getFullYear()} {SITE_TITLE}.</p>
 <p>Thoughts, notes, and things learned along the way.</p>
 <p><a href={withBase('/about')}>About this blog</a> <span aria-hidden="true">·</span> Subscribe via <a href={withBase('/rss.xml')}>RSS</a>.</p>
</footer>
<style>
 .site-footer { width: min(640px, calc(100% - 48px)); margin: 64px auto 0; padding: 28px 0 56px; border-top: 1px solid var(--rule); color: var(--muted); font-size: 15px; text-align: center; }
 p { margin: 5px 0; }
 span { margin: 0 6px; }
</style>
