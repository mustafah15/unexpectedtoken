---
import type { HTMLAttributes } from 'astro/types';
type Props = HTMLAttributes<'a'>;
const { href, class: className, ...props } = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const target = href?.replace(/\/$/, '') || '/';
const home = import.meta.env.BASE_URL.replace(/\/$/, '') || '/';
const isActive = pathname === target || (target !== home && pathname.startsWith(`${target}/`));
---
<a href={href} class:list={[className, { active: isActive }]} aria-current={isActive ? 'page' : undefined} {...props}><slot /></a>
<style>
 a { text-underline-offset: 4px; }
 a.active { color: var(--text); text-decoration: none; }
</style>
